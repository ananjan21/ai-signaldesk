# AI SignalDesk environment template
# Copy this to your hosting environment or local shell setup.
# Do not put real secrets in Git.

# Server
PORT=4173
NODE_ENV=development

# Security
# Set this before exposing the app publicly. Use a long random value.
WEBHOOK_TOKEN=change-me-long-random-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Request and rate-limit tuning
MAX_BODY_BYTES=1048576
MAX_POSTS_PER_REQUEST=50
FUTURE_DATE_TOLERANCE_DAYS=30
RATE_LIMIT_WINDOW_MS=900000

# Agentic AI live update
N8N_LIVE_WEBHOOK_URL=https://agentic-ai.example.com/webhook/ai-opportunity-live-update
N8N_LIVE_WEBHOOK_TOKEN=

# n8n Gmail email workflow
N8N_EMAIL_WEBHOOK_URL=
N8N_EMAIL_WEBHOOK_TOKEN=

# MCP connector server
MCP_PORT=4174
MCP_HOST=0.0.0.0
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,localhost:4174,127.0.0.1:4174
MCP_TOKEN=change-me-long-random-token
AI_SIGNALDESK_PUBLIC_URL=http://localhost:4173

# OpenRouter chatbot
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_SITE_URL=http://localhost:4173
OPENROUTER_SITE_NAME=AI SignalDesk

# SMTP email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
