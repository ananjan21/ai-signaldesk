# AI SignalDesk production environment
# Copy to .env on the VPS and replace secrets before running Docker Compose.

COMPOSE_PROJECT_NAME=ai-signaldesk

# Public ports exposed by Docker. Put Nginx/Caddy/Cloudflare in front for HTTPS.
WEB_PORT=4173
MCP_PORT=4174
MCP_HOST=0.0.0.0
MCP_ALLOWED_HOSTS=your-domain.com,your-domain.com:443,your-domain.com:4174

# Public HTTPS URL for the web app, after DNS/reverse proxy is configured.
AI_SIGNALDESK_PUBLIC_URL=https://your-domain.com

# Required. Use long random secrets.
WEBHOOK_TOKEN=replace-with-long-random-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-admin-password
MCP_TOKEN=replace-with-long-random-token

# Validate each source URL before a feed item is accepted.
SOURCE_CHECK_ENABLED=true
SOURCE_CHECK_TIMEOUT_MS=8000
SOURCE_CHECK_CONCURRENCY=8
SOURCE_CHECK_ALLOW_403_HOSTS=remotive.com

# Optional agentic AI live update hook.
N8N_LIVE_WEBHOOK_URL=https://agentic-ai.example.com/webhook/ai-opportunity-live-update
N8N_LIVE_WEBHOOK_TOKEN=

# Optional n8n Gmail email workflow. Preferred over SMTP when configured.
N8N_EMAIL_WEBHOOK_URL=
N8N_EMAIL_WEBHOOK_TOKEN=

# Optional chatbot.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# Optional SMTP email sending. Required for subscription welcome emails and admin test email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
